{
  "name": "speedtest-ai",
  "version": "0.2.0",
  "description": "Live speedometer CLI and streaming benchmark engine for AI models and agent harnesses.",
  "type": "module",
  "bin": {
    "speedtest-ai": "./dist/cli.js",
    "aispeed": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "ai",
    "llm",
    "tps",
    "speedtest",
    "benchmark",
    "claude",
    "codex",
    "ollama",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
