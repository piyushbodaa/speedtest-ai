{
  "name": "speedtest-ai",
  "version": "0.10.1",
  "description": "Live speedometer CLI and streaming benchmark engine for AI models and agent harnesses.",
  "type": "module",
  "bin": {
    "speedtest": "./dist/cli.cjs",
    "speedtest-ai": "./dist/cli.cjs",
    "aispeed": "./dist/cli.cjs",
    "kmspeed": "./dist/cli.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release:bundle": "node scripts/release.mjs"
  },
  "keywords": [
    "ai",
    "llm",
    "tps",
    "speedtest",
    "benchmark",
    "claude",
    "codex",
    "ollama",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12"
  },
  "author": "Krutrim Mulyankan (https://krutrimmulyankan.in)",
  "homepage": "https://krutrimmulyankan.in/speedtest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piyushbodaa/speedtest-ai.git"
  }
}
